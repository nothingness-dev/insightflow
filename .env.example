# کپی این فایل با نام .env و مقادیر را تنظیم کنید
# Copy this file to .env and fill in all values before running the app.
# Never commit your real .env file — it is blocked by .gitignore.

# ─── Django ───────────────────────────────────────────────────────────────────
# Generate a real key: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-this-to-a-very-long-random-secret-key-minimum-50-chars

DEBUG=False

# Comma-separated list of hostnames/IPs the server responds to.
# Example: 192.168.1.100,myserver.local,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Must exactly match the origin users browse to (scheme + host, no trailing slash).
# Example: http://192.168.1.100,http://myserver.local
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# Public URL used when admins copy anonymous hash links.
# Example: http://192.168.1.100 or http://survey.company.local
VITE_PUBLIC_BASE_URL=http://localhost

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_NAME=surveydb
DB_USER=surveyuser
DB_PASSWORD=change-this-to-a-strong-database-password

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── First admin account (auto-created on first boot if it doesn't exist) ────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-to-a-strong-admin-password
ADMIN_FULL_NAME=مدیر سیستم

# ─── Uploads ──────────────────────────────────────────────────────────────────
# Maximum upload size in bytes (default: 2 MB)
MAX_UPLOAD_SIZE=2097152
