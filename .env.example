# Copy this file to .env and configure the values
# این فایل را با نام .env کپی کرده و مقادیر را تنظیم کنید

# Django
SECRET_KEY=change-this-to-a-very-long-random-secret-key-minimum-50-chars
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
DB_NAME=surveydb
DB_USER=surveyuser
DB_PASSWORD=change-this-strong-database-password

# Initial admin account created on first run
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_FULL_NAME=مدیر سیستم

# Media & Security
MAX_UPLOAD_SIZE=2097152
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
